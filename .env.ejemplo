# Copie este archivo como .env y escriba sus propios valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Usuario administrador
ADMIN_CORREO=
ADMIN_CLAVE=

# Usuario normal
USUARIO_CORREO=
USUARIO_CLAVE=

# Clave para firmar la sesión de Flask (invente una cadena larga y secreta)
SECRET_KEY=

# Base de datos (Supabase). Si está vacío, se usa SQLite local.
DATABASE_URL=
